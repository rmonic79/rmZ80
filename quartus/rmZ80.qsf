set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY rmZ80
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/rmZ80.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/rmZ80_cw.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/rmZ80_alu_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/rmZ80_alu_dec.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/rmZ80_alu_daa.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/rmZ80_alu_core.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/rmZ80_alu.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/rmZ80_regfile.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/rmZ80_seq.sv
set_global_assignment -name SDC_FILE rmZ80.sdc
set_global_assignment -name VERILOG_MACRO "SYNTHESIS=1"

set_global_assignment -name LAST_QUARTUS_VERSION "17.0.0 Lite Edition"
# parallel savestate: the two 274-bit buses are not physical pins of the device
set_instance_assignment -name VIRTUAL_PIN ON -to ss_din[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ss_dout[*]
